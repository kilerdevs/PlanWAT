# Copy to .env next to compose.yml.
# One-hour registration token (Settings -> Actions -> Runners -> New self-hosted runner); only the first
# start needs it, remove it afterwards.
RUNNER_TOKEN=
RUNNER_NAME=planwat-runner
# Labels set at registration: planwat plus this box's label in tools/refresh/fleet.json.
RUNNER_LABELS=planwat,planwat-oracle
# Shared by the egress GUI/API and the crawler's reports to it; generate with: openssl rand -hex 24
EGRESS_API_TOKEN=

# Optional Cloudflare Worker relay for faculties that wall this box (docs/EGRESS.md). Leave
# PLANWAT_RELAY_URL empty to keep the relay off. When set, also set EGRESS_DIRECT_HOSTS to the
# Worker's hostname (without https://), or the egress will refuse the relay request with 403.
# PLANWAT_RELAY_HOSTS is optional: empty uses the default walled-host list; "off" disables the
# relay without unsetting the URL. The relay replaces a direct request, it does not fall back:
# list only hosts this box cannot reach directly (plebania, for example: wel,wig).
PLANWAT_RELAY_URL=
PLANWAT_RELAY_TOKEN=
PLANWAT_RELAY_HOSTS=
EGRESS_DIRECT_HOSTS=
