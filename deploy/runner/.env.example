# Copy to .env next to compose.yml.
# One-hour registration token (Settings -> Actions -> Runners -> New self-hosted runner); only the first
# start needs it, remove it afterwards.
RUNNER_TOKEN=
RUNNER_NAME=planwat-runner
# Labels set at registration: planwat plus this box's label in tools/refresh/fleet.json.
RUNNER_LABELS=planwat,planwat-oracle1
# Shared by the egress API and the crawler's reports to it; generate with: openssl rand -hex 24. Required: the
# egress refuses to start without it.
EGRESS_API_TOKEN=
# The egress panel's own sign-in (and POST /api/refresh), never given to the crawler; openssl rand -hex 24.
# Empty = the panel takes EGRESS_API_TOKEN, as before.
EGRESS_ADMIN_TOKEN=

# Optional Cloudflare Worker relay for faculties that wall this box (docs/EGRESS.md). Leave
# PLANWAT_RELAY_URL empty to keep the relay off. When set, also set EGRESS_DIRECT_HOSTS to the
# Worker's hostname (without https://), or the egress will refuse the relay request with 403.
# PLANWAT_RELAY_HOSTS is optional: empty uses the default walled-host list; "off" disables the
# relay without unsetting the URL. The relay replaces a direct request, it does not fall back:
# list only hosts this box cannot reach directly (plebania, for example: wel,wig).
PLANWAT_RELAY_URL=
PLANWAT_RELAY_TOKEN=
PLANWAT_RELAY_HOSTS=
EGRESS_DIRECT_HOSTS=

# The crawl's clock (tools/refresh/ticker.py, the `ticker` service): GitHub's own cron starts passes hours late or not
# at all, so every always-up server starts them itself. COMPOSE_PROFILES=ticker turns it on. The token: a fine-grained
# personal access token for kilerdevs/PlanWAT only, with Actions read and write and nothing else; one token serves
# every server. The delay staggers the servers (oracle1 0, oracle2 4, oracle3 8, plebania 12 minutes): each starts a
# slot's run only when no server before it has.
COMPOSE_PROFILES=
PLANWAT_TICKER_TOKEN=
PLANWAT_TICKER_DELAY=0
