# Copy to .env next to compose.yml and fill in. Keep this file private: it holds your token.
PLANWAT_LOGIN=your-github-login
# PLANWAT_FORK=your-github-login/PlanWAT
# Fine-grained personal access token: Repository access = only your fork; Permissions = Contents: Read and write.
PLANWAT_FORK_TOKEN=github_pat_...
# PLANWAT_DRY_RUN=1   # first run: crawl and build the bundle, push nothing
# PLANWAT_ONCE=1      # one pass, then exit
# Optional Cloudflare Worker relay for faculties that wall your line (docs/EGRESS.md).
# Leave the URL empty to keep it off. When set, EGRESS_DIRECT_HOSTS must name the Worker's
# exact hostname so the volunteer egress lets the relay request out.
# PLANWAT_RELAY_URL=https://planwat-egress.<account>.workers.dev
# PLANWAT_RELAY_TOKEN=...
# EGRESS_DIRECT_HOSTS=planwat-egress.<account>.workers.dev
