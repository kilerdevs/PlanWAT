FROM python:3.13-slim

LABEL org.opencontainers.image.source=https://github.com/kilerdevs/PlanWAT \
      org.opencontainers.image.description="PlanWAT egress proxy (docs/EGRESS.md)"

# No HTTP(S)_PROXY here on purpose: this box *is* the egress, it fetches proxy
# lists and probes candidates over its own direct route.
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1

WORKDIR /srv/egress
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && \
    useradd -r -u 10002 -s /usr/sbin/nologin egress && \
    mkdir -p /data && chown egress:egress /data

COPY pool.py server.py ./

USER 10002:10002
EXPOSE 8888 8080
VOLUME /data
CMD ["python", "server.py"]
