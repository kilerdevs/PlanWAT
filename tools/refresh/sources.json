    "note": "Enabled 2026-10-13: the live index.xml is resolved via the landing page iframe (revisioned dirs); WMT-coded groups convert with wlo2ics. Watch the first runs."
  },
  "wtc": {
    "driver": "wtc",
    "label": "WTC",
    "prefix": "WTC",
    "base": "https://wtc.wat.edu.pl/Plany/{season}/",
    "enabled": true,
    "note": "Enabled 2026-10-13: crawler + PDF converter in drivers/wtc (pymupdf). Watch the first runs; the site sits behind Incapsula."
  }
