{
  "wlo": {
    "driver": "plansoft",
    "label": "WLO",
    "prefix": "WLO",
    "base": "https://wlo.wat.edu.pl/planzajec/{season}/",
    "enabled": true
  },
  "wel": {
    "driver": "plansoft",
    "label": "WEL",
    "prefix": "WEL",
    "keep_prefixes": ["WME"],
    "base": "https://wel.wat.edu.pl/planyzajec/{season}/",
    "enabled": true
  },
  "wim": {
    "driver": "plansoft",
    "label": "WIM",
    "prefix": "",
    "base": "https://www.wim.wat.edu.pl/wp-content/uploads/rozklady/{season}/",
    "enabled": true
  },
  "wcy": {
    "driver": "wcy",
    "label": "WCY",
    "index": "https://planzajec.wcy.wat.edu.pl/pl/rozklad",
    "page": "https://planzajec.wcy.wat.edu.pl/pl/rozklad?grupa_id={group}",
    "enabled": false,
    "note": "Enable after a dry run proves plain HTTP works; the old crawler used a browser."
  },
  "wml": {
    "driver": "wml",
    "label": "WML",
    "prefix": "WML",
    "keep_prefixes": ["WMT"],
    "groups_re": "^WMT",
