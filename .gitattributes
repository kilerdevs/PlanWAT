# Text is normalised to LF...
* text=auto eol=lf

# ...except calendars, which are stored byte-for-byte: RFC 5545 requires CRLF line
# endings, and calendar apps subscribed to /<GROUP>/plan.ics rely on them.
*.ics -text diff

# Saved faculty pages used as test fixtures keep their bytes.
tests/fixtures/refresh/*.htm -text
tests/fixtures/refresh/*.pdf -text

# The campus map's vendored vector tiles and glyphs (src/map/) are protobuf: bytes, never text.
*.pbf binary
